CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
GH_TOKEN=ghp_...
MAX_CONCURRENT_AGENTS=3
DASHBOARD_PORT=8420
# Agents only start when a comment containing this mention appears on the issue.
# Set to empty to pick up issues immediately on label.
TRIGGER_MENTION=@swarmops
# Git author identity for agent commits (avoids Vercel deploy rejections).
# Use a GitHub-associated name/email so platforms recognise the commit author.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your-email@example.com
# Dashboard admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here

# === Merge-Conflict Resolution ===
# Scan all open (same-repo, non-draft) PRs for merge conflicts and dispatch an
# agent to merge the base branch in, resolve conflicts, and push back to the PR.
TRACK_MERGE_CONFLICTS=true
# How often (seconds) to scan open PRs for conflicts.
CONFLICT_POLL_INTERVAL_SECONDS=180
# Max resolution attempts per PR against the same base commit before escalating.
MAX_CONFLICT_FIX_RETRIES=3
