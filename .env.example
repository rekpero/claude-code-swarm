# === Deployment mode ===
# "single_tenant" (default) = OSS self-host / internal team. Runs exactly like
#   before: env credentials below, no Postgres, no encryption setup.
# "multi_tenant"  = managed cloud. Per-org encrypted credentials in Postgres
#   (see the multi-tenant block further down).
DEPLOYMENT_MODE=single_tenant

# --- Single-tenant credentials (used when DEPLOYMENT_MODE=single_tenant) ---
# The agent runs with whichever of these is set. Your existing setup keeps
# working unchanged: if you already use CLAUDE_CODE_OAUTH_TOKEN, leave it.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# Or run on a Console API key instead (API billing):
# ANTHROPIC_API_KEY=sk-ant-api03-...
GH_TOKEN=ghp_...
MAX_CONCURRENT_AGENTS=3

# === Multi-tenant only (ignore for single-tenant self-host) ===
# Postgres connection (system of record). Create the schema with: alembic upgrade head
# DATABASE_URL=postgresql+psycopg://swarmops:swarmops@localhost:5432/swarmops
# Secret storage backend: "fernet" (encrypted at rest) or "env" (dev only).
# SECRET_BACKEND=fernet
# Master key-encryption-key for the fernet backend. Generate once with:
#   python -c "from orchestrator.infra.crypto import generate_master_key; print(generate_master_key())"
# TODO(kms): source this from a KMS / secrets manager before serving real customers.
# SECRETS_MASTER_KEY=
# Credential provider for agent runs. "api_key" = each org brings its own Anthropic key.
# CREDENTIAL_PROVIDER=api_key
DASHBOARD_PORT=8420
# Agents only start when a comment containing this mention appears on the issue.
# Set to empty to pick up issues immediately on label.
TRIGGER_MENTION=@swarmops
# Git author identity for agent commits (avoids Vercel deploy rejections).
# Use a GitHub-associated name/email so platforms recognise the commit author.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=your-email@example.com
# Dashboard admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here

# === Merge-Conflict Resolution ===
# Scan all open (same-repo, non-draft) PRs for merge conflicts and dispatch an
# agent to merge the base branch in, resolve conflicts, and push back to the PR.
TRACK_MERGE_CONFLICTS=true
# How often (seconds) to scan open PRs for conflicts.
CONFLICT_POLL_INTERVAL_SECONDS=180
# Max resolution attempts per PR against the same base commit before escalating.
MAX_CONFLICT_FIX_RETRIES=3
